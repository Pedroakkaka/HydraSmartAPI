# HydraSmart API — copie para ".env" e ajuste. O arquivo .env NUNCA vai para o Git.

# ---------- Servidor ----------
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
# Endereços do painel autorizados a chamar a API (separe por vírgula)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# ---------- Banco de dados (PostgreSQL) ----------
POSTGRES_DB=hydrasmart
POSTGRES_USER=hydrasmart
POSTGRES_PASSWORD=hydrasmart
DB_PORT=5433
DATABASE_URL=postgres://hydrasmart:hydrasmart@localhost:5433/hydrasmart
# Em desenvolvimento, se o banco não responder, a API sobe com dados só em memória
DB_FALLBACK_MEMORIA=true

# ---------- Arduino (porta USB) ----------
SERIAL_ENABLED=true
# "auto" detecta a placa sozinho; ou informe a porta: COM3, COM4, /dev/ttyUSB0...
SERIAL_PORT=auto
SERIAL_BAUD=115200
SERIAL_AUTO_RECONNECT=true
# Sem leitura por este tempo, o bueiro aparece como "desatualizado"
SERIAL_STALE_MS=8000

# ---------- Integrações ----------
# Chave que sensores em campo devem mandar no cabeçalho X-API-Key (POST /api/v1/leituras)
# Gere uma com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INGEST_API_KEY=
# Para renovação automática de token pelo SGAA (configurar somente no backend)
CEMADEN_EMAIL=
CEMADEN_PASSWORD=
# Alternativa temporária, sem renovação automática
CEMADEN_JWT_TOKEN=

# ---------- Porto Alegre-RS ----------
MUNICIPIO_NOME=Porto Alegre - RS
MUNICIPIO_LATITUDE=-30.0346
MUNICIPIO_LONGITUDE=-51.2177
MUNICIPIO_TIMEZONE=America/Sao_Paulo
# Cloudflare Workers AI: token somente no servidor, nunca publique o .env
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
# Teste manual exige OPERATOR_API_KEY, habilitação explícita e uma chamada por execução
OPERATOR_API_KEY=
ENABLE_AI_TEST=false
ENABLE_PUBLIC_AI=false
ENABLE_AUTOMATIC_AI=false
