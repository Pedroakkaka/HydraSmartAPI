{
  "name": "hydrasmart-api",
  "version": "3.0.0",
  "description": "HydraSmart API — back-end de monitoramento de drenagem urbana (Fastify + PostgreSQL + leitura serial do Arduino)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "pino": "^9.14.0"
  },
  "optionalDependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "pino-pretty": "^13.2.0"
  },
  "license": "UNLICENSED",
  "private": true
}
